{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    }
  },
  "functionTimeout": "00:05:00",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxConcurrentRequests": 100,
      "maxOutstandingRequests": 30
    }
  },
  "cors": {
    "allowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ],
    "allowedMethods": [
      "GET",
      "POST",
      "OPTIONS"
    ],
    "allowedHeaders": [
      "Content-Type",
      "Authorization"
    ],
    "maxAge": 3600
  }
}
