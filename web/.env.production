# Committed default for production builds (see src/config.ts). Not a secret —
# just the expected public URL. Override in the Cloudflare Pages dashboard's
# build environment variables once a custom domain is attached; no code
# change needed either way.
VITE_SITE_URL=https://legendscollide.pages.dev

# Cloudflare Web Analytics beacon token (cookieless, no consent banner).
# Leave empty until the Pages project exists and you copy its token from
# the dashboard — the analytics script is skipped entirely when this is unset.
VITE_CF_BEACON_TOKEN=
